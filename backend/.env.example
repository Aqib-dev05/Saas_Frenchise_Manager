# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/franchise_manager"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Server
PORT=5000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Paddle Billing
PADDLE_API_KEY="your-paddle-api-key"
PADDLE_WEBHOOK_SECRET="your-paddle-webhook-secret"
PADDLE_ENVIRONMENT="sandbox"

# Paddle Price IDs (from your Paddle dashboard)
PADDLE_PRICE_STARTER_MONTHLY="pri_starter_monthly"
PADDLE_PRICE_STARTER_YEARLY="pri_starter_yearly"
PADDLE_PRICE_PRO_MONTHLY="pri_pro_monthly"
PADDLE_PRICE_PRO_YEARLY="pri_pro_yearly"
PADDLE_PRICE_ENTERPRISE_MONTHLY="pri_enterprise_monthly"
PADDLE_PRICE_ENTERPRISE_YEARLY="pri_enterprise_yearly"
