# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/franchise_manager"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# Server
PORT=5000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# Paddle Billing
PADDLE_API_KEY="your-paddle-api-key"
PADDLE_WEBHOOK_SECRET="your-paddle-webhook-secret"
PADDLE_ENVIRONMENT="sandbox"

# Paddle Price IDs (from your Paddle dashboard)
PADDLE_PRICE_STARTER_MONTHLY="pri_starter_monthly"
PADDLE_PRICE_STARTER_YEARLY="pri_starter_yearly"
PADDLE_PRICE_PRO_MONTHLY="pri_pro_monthly"
PADDLE_PRICE_PRO_YEARLY="pri_pro_yearly"
PADDLE_PRICE_ENTERPRISE_MONTHLY="pri_enterprise_monthly"
PADDLE_PRICE_ENTERPRISE_YEARLY="pri_enterprise_yearly"

# Cloudinary (image uploads — profile pictures & product photos)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Email (password reset OTP) ───────────────────────────────────────────────
# Priority: SMTP (if set) → Google Gmail API (if set) → console log (dev mode)
#
# Option A — SMTP (use this if your host allows outbound SMTP, e.g. a VPS):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
#
# Option B — Google Gmail API via OAuth2 (recommended for Vercel/serverless —
# it's a plain HTTPS call, not a raw SMTP socket, so it works on free hosting
# tiers that block SMTP ports). One-time setup:
#   1. Go to console.cloud.google.com → create a project → enable "Gmail API"
#   2. APIs & Services → Credentials → Create OAuth client ID (type: Web app)
#      Add this Authorized redirect URI: https://developers.google.com/oauthplayground
#   3. Go to https://developers.google.com/oauthplayground
#      → click the gear icon (top right) → check "Use your own OAuth credentials"
#        → paste your Client ID + Client Secret
#      → in the left panel, select scope: https://www.googleapis.com/auth/gmail.send
#      → Authorize APIs → sign in with the Gmail account you want to send FROM
#      → click "Exchange authorization code for tokens" → copy the Refresh Token
#   4. Paste that refresh token below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_SENDER_EMAIL=""
